#!/usr/bin/env bash

#MISE description="Build the application (Release)"
#MISE sources=["Cargo.toml", "src/**/*.rs", "rules/**/*.toml"]
#MISE outputs=["target/release/hodor"]
#MISE depends=["test"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cargo build --quiet --release --workspace "$@"
