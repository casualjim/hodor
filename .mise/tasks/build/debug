#!/usr/bin/env bash

#MISE description="Build the application (Debug)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**"]
#MISE outputs=["target/debug/hodor"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# `--exclude hodor-ebpf-programs`: it is a workspace member only so `aya-build`
# can resolve it, and its sources compile for the `bpf` target alone. Every
# host-wide command has to exclude it.
cargo build --quiet --workspace --exclude hodor-ebpf-programs "$@"
