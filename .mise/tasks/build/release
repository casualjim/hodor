#!/usr/bin/env bash

#MISE description="Build the application (Release)"
#MISE sources=["Cargo.toml", "crates/**/*.rs"]
#MISE outputs=["target/release/hodor"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# `--exclude hodor-ebpf-programs`: it is a workspace member only so `aya-build`
# can resolve it, and its sources compile for the `bpf` target alone. Every
# host-wide command has to exclude it.
cargo build --quiet --release --workspace --exclude hodor-ebpf-programs "$@"
