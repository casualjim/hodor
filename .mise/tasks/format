#!/usr/bin/env bash

#MISE description="Run the linters and formatters"

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

# hk is git-only, and a jj workspace has no `.git` of its own. Bridge to the
# jj repo's git backend so hk can resolve files, but keep every write out of
# that shared repo: the scratch index and object store live under `.cache`,
# which both `.gitignore` and `.jjignore` exclude. Without this, hk's staging
# would land in the repo that owns the git backend, outside this workspace.
if jj root >/dev/null 2>&1 && [ -n "$(jj git root 2>/dev/null)" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
  scratch="$proj_dir/.cache/hk"
  mkdir -p "$scratch/objects"
  export GIT_DIR
  GIT_DIR=$(jj git root)
  export GIT_WORK_TREE="$proj_dir"
  export GIT_INDEX_FILE="$scratch/index"
  export GIT_OBJECT_DIRECTORY="$scratch/objects"
  export GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects"
fi

hk run fix --quiet --all
