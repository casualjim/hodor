#!/usr/bin/env bash

#MISE description="Run the live TUN tests (build as user, execute as root)"
#MISE sources=["Cargo.toml", "src/**/*.rs"]
#USAGE flag "--use-sudo" help="Skip the gum escalation prompt and go straight to sudo"
#USAGE arg "[filters]" var=#true help="Test-name filters; default: tun_"

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Build the test binary as the current user so target/ stays user-owned.
cargo nextest run --no-run --cargo-quiet --features tun

# Locate the single test binary produced by the build.
test_bin=$(cargo nextest list --features tun --message-format json |
  jq -r '.["rust-suites"] |
  if length == 1 then first(.[]) | .["binary-path"] else error("expected 1 test binary, got \(length)") end')

# Default to the tun_ prefix unless the caller narrows it.
eval "filters=(${usage_filters:-})"
if [ ${#filters[@]} -eq 0 ]; then
  filters=(tun_)
fi

if [ "${usage_use_sudo:-false}" = "true" ]; then
  sudo env HODOR_TEST_TUN=1 "$test_bin" --test-threads=1 --ignored "${filters[@]}"
else
  if ! gum confirm "TUN tests need root; escalate with sudo?"; then
    echo "escalation declined; test binary: $test_bin" >&2
    exit 1
  fi
  sudo env HODOR_TEST_TUN=1 "$test_bin" --test-threads=1 --ignored "${filters[@]}"
fi