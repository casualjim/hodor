# Copy to hodor.toml and fill in the real values. Only the hodor container
# mounts this file. The agent container holds the decoys instead and never
# reads this one.

[proxy]
# Capture does not use the listener, but hodor always binds one. It is on
# loopback in hodor's namespace, which the agent shares, so the agent can also
# set HTTPS_PROXY=http://127.0.0.1:8080 as a fallback.
listen = "127.0.0.1:8080"
ca_file = "/certs/ca.pem"

# Both env names below are registry-known (anthropic, github), so resolution
# unions each registry entry's hosts into that rule's `allow`. Add
# `registry = false` to a rule to keep only the literal hosts.
[rules.anthropic]
env = "ANTHROPIC_API_KEY"
value = "sk-ant-api03-REPLACE-WITH-THE-REAL-KEY"
allow = ["https://api.anthropic.com"]

[rules.github]
env = "GH_TOKEN"
value = "ghp_REPLACE-WITH-THE-REAL-TOKEN"
allow = ["https://api.github.com", "https://github.com", "https://*.githubusercontent.com"]
