amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local rust_steps = new Mapping<String, Step> {

  ["cargo-check"] = (Builtins.cargo_check) {
    // `--workspace` because the root package doubles as the workspace root, so
    // a bare `cargo check --all-targets` would cover only the root binary:
    // every crate's unit tests would go unchecked.
    // `--exclude hodor-ebpf-programs` because that crate is a workspace member
    // only so `aya-build` can resolve it with `--package`; it compiles for the
    // `bpf` target alone, and building it for the host fails on the panic
    // handler. `aya-build` builds it as part of `hodor-ebpf`, so the gate still
    // covers it.
    check = "cargo check --workspace --exclude hodor-ebpf-programs --all-targets"
    fix = "cargo check --workspace --exclude hodor-ebpf-programs --all-targets"
    depends = "rustfmt"
    check_first = true
  }

  ["cargo-clippy"] = new Step {
    glob = List("**/*.rs")
    stage = List("**/*.rs")
    check = "cargo clippy --workspace --exclude hodor-ebpf-programs --all-targets -- -D warnings"
    fix = "cargo clippy --workspace --exclude hodor-ebpf-programs --all-targets --fix --allow-dirty --allow-staged -- -D warnings"
    check_first = true
    depends = "cargo-check"
  }

  ["rustfmt"] = new Step {
    glob = List("**/*.rs")
    stage = List("**/*.rs")
    check = "rustfmt --edition 2024 --check {{files}}"
    fix = "rustfmt --edition 2024 {{files}}"
    depends = "cargo-sort"
  }

  ["cargo-sort"] = new Step {
    glob = List("**/Cargo.toml")
    stage = List("**/Cargo.toml")
    check = "cargo sort --grouped --check ."
    fix = "cargo sort --grouped ."
    check_first = true
  }

}

local project_steps = new Mapping<String, Step> {
  ...rust_steps

  ["shellcheck"] = Builtins.shellcheck

  ["hadolint"] = Builtins.hadolint

  ["lychee"] = new Step {
    glob = List("**/*.md")
    check = "lychee {{files}}"
  }

  ["check-toml"] = (Builtins.taplo) {
    glob = List("**/*.toml")
  }

  ["check-merge-conflict"] = Builtins.check_merge_conflict

  ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = project_steps
  }

  ["check"] {
    steps = project_steps
  }

  ["fix"] {
    fix = true
    steps = project_steps
  }
}
