# Copy to integration/.env (gitignored) and adjust. These are throwaway
# demo values, but the plumbing is the production pattern: hodor resolves
# rule values from fnox at serve time, and the values reach the containers
# by environment — never from a committed rules file.
HODOR_REAL=ghp_deadbeefdeadbeefdeadbeefdeadbeefdeadbeef
HODOR_DB_REAL=postgres://hodor:hodor_real_password_01@db:5432/demo?sslmode=require
OIDC_CLIENT_SECRET=oidc-real-secret-0123456789
OIDC_ACCESS_TOKEN=real-access-token-abcdef123456
